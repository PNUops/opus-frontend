+        onCloseFocus();
+      }}
+    >
+      <div className="min-w-0 pr-10">
+        <DialogTitle className="text-left text-lg font-semibold text-neutral-900">투표 리포트 PDF</DialogTitle>
+        <p className="mt-1 truncate text-sm text-neutral-600" title={contestName}>
+          {contestName}
+        </p>
+      </div>
